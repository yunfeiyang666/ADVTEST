# =============================================================================
# 与 advtest_runtime.env.SERVER_COPYME 内容一致（任选其一复制为 advtest_runtime.env）
#
#   cp advtest_runtime.env.linux.example advtest_runtime.env
#
# ⚠️ 不要用 advtest_runtime.env.example（Windows E:/ 路径）拷到 Linux。
# =============================================================================

ADVTEST_ROOT=/home/yunyang/ADVTEST/DATA_new

# ── nuScenes / NuScenes-QA ──
NUSCENES_DATAROOT=/home/yunyang/ADVTEST/DATA_new/data
NUSCENES_VERSION=v1.0-trainval
VQA_QA_JSON=/home/yunyang/ADVTEST/DATA_new/data/NuScenes_val_questions.json

# Excel（须已存在；与单机文档二选一即可）
ADVTEST_EXCEL_PATH=/home/yunyang/ADVTEST/DATA_new/data/RQ_nuscenesqa_val_full.xlsx
# ADVTEST_EXCEL_PATH=/home/yunyang/ADVTEST/RQ_server_a.xlsx

ADVTEST_GEN_QA_DIR=/home/yunyang/ADVTEST/DATA_new/generated_qa
FILTERED_SG_DIR=/home/yunyang/ADVTEST/DATA_new/filtered_scene_graphs

# ── V17：现场构图 + 帧表 ──
VQA_BUILD_SCENE_GRAPH_ONTHEFLY=true
ADVTEST_FRAME_PLAN_JSON=/home/yunyang/ADVTEST/DATA_new/code/deploy/nuscenesqa_val_plan_full.json
# 续跑：先生成 skip 文件后，改为下面一行并注释掉上一行
# ADVTEST_FRAME_PLAN_JSON=/home/yunyang/ADVTEST/DATA_new/code/deploy/nuscenesqa_val_plan_resume_skip3.json

# Linux：pip install nuscenes-devkit；不要设置 Windows 的 NUSCENES_DEVKIT_PATH
# NUSCENES_DEVKIT_PATH=

# ── Neo4j ──
VQA_SKIP_NEO4J_DOCKER=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写

NEO4J_DOCKER_NAMES=neo4j,advtest-neo4j

# ── LLM（OpenAI 兼容；模型名须与网关 /v1/models 一致）──
# 主模型默认 35B。若改 122B，须三行同名一起改。
VQA_API_BASE_URL=http://218.197.140.7:3001/v1
VQA_API_KEY=请填写
VQA_MODEL_NAME=Qwen3.5-35B-A3B
VQA_MODEL_AUDIT=Qwen3.5-35B-A3B
VQA_MODEL_RENDER=Qwen3.5-35B-A3B
VQA_Q_BATCH_SIZE=32
VQA_Q_N_WORKERS=32
VQA_BASELINE_N_WORKERS=32
VQA_LLM_TIMEOUT_READ=180

VQA_CLEAR_RUN_DATA=false
VQA_AUTO_CONNECT_VPN=false

# Gap：防空转 + 失败 cell 冷却（0=关闭冷却）
VQA_MAX_EMPTY_STREAK=15
VQA_GAP_FAIL_COOLDOWN=3
