# 按 yunyang 服务器上 ADVTEST 布局填写；复制/改名为本目录下的 advtest_rebuild.local.env
#   cp advtest_rebuild.env.yunyang_server.example advtest_rebuild.local.env
# run_full_pipeline（rebuild 侧）会固定读取：/home/yunyang/ADVTEST/DATA_new/code/advtest_rebuild.local.env
#
# 你的 DATA_new/data/ 含：maps、samples、v1.0-trainval、NuScenes_val_questions.json 等
# 无 sweeps/ → 必须保持 SKIP_NUSCENES_CHECK=1（全量 trainval 含 sweeps 再改 0）
#
# 目录速览（与变量对应）:
#   ~/ADVTEST/neo4j/                     Neo4j 程序与 data/
#   ~/ADVTEST/DATA_new/data/             NUSCENES_DATA_ROOT
#   ~/ADVTEST/DATA_new/filtered_scene_graphs/   场景图 JSON（与 SCENE_GRAPH_DIR 一致）
#   ~/ADVTEST/DATA_new/coverage_state/   缺口/覆盖 输出
#   ~/ADVTEST/DATA_new/generated_qa/     生成题 CSV 等
#   ~/ADVTEST/DATA_new/code/deploy/     plan JSON

ADVTEST_ROOT=/home/yunyang/ADVTEST/DATA_new
NUSCENES_DATA_ROOT=/home/yunyang/ADVTEST/DATA_new/data
BASELINE_QA_PATH=/home/yunyang/ADVTEST/DATA_new/data/NuScenes_val_questions.json

SCENE_GRAPH_DIR=/home/yunyang/ADVTEST/DATA_new/filtered_scene_graphs
COVERAGE_STATE_DIR=/home/yunyang/ADVTEST/DATA_new/coverage_state
OUTPUT_DIR=/home/yunyang/ADVTEST/DATA_new/generated_qa
SERVER_PLAN_PATH=/home/yunyang/ADVTEST/DATA_new/code/deploy/nuscenesqa_val_plan_server2.json

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请改为真实密码

LLM_API_ENDPOINT=http://218.197.140.7:3001/v1
LLM_API_KEY=请改为真实 Key
LLM_MODEL=Qwen3.5-35B-A3B
LLM_MODEL_ALTERNATIVES=
LLM_TIMEOUT=180

VQA_API_BASE_URL=http://218.197.140.7:3001/v1
VQA_API_KEY=请改为真实 Key
VQA_MODEL_NAME=Qwen3.5-35B-A3B
VQA_LLM_TIMEOUT_READ=180

SKIP_NUSCENES_CHECK=1
PIPELINE_GEN_ONLY=0
PIPELINE_INIT_SKIP_LLM_CHECK=0
GENERATION_LLM_BATCH_SIZE=2
BATCH_SIZE=32
