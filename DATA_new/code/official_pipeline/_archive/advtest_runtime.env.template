# ADVTEST 运行时环境变量模板
# 每台机器需要修改 __FILL_ME__ 的部分

# ──── 路径配置 ────
ADVTEST_ROOT=__FILL_ME__                  # e.g. /home/user/ADVTEST
NUSCENES_DATAROOT=__FILL_ME__             # e.g. /data/nuscenes
NUSCENES_VERSION=v1.0-trainval
VQA_QA_JSON=__FILL_ME__                   # NuScenes_val_questions.json 路径
ADVTEST_ORIGINAL_QA=__FILL_ME__           # 同上
ADVTEST_SAMPLE_TOKEN_MAP=__FILL_ME__      # sample_token_to_scene.json 路径

# ──── 场景图 ────
FILTERED_SG_DIR=__FILL_ME__               # 场景图根目录
VQA_BUILD_SCENE_GRAPH_ONTHEFLY=true

# ──── 初始覆盖 ────
ADVTEST_INITIAL_COVERAGE_LLM=true         # 初始覆盖使用 LLM (作为确定性匹配的 fallback)

# ──── LLM API ────
VQA_API_BASE_URL=__FILL_ME__              # e.g. http://218.197.140.7:3001/v1
VQA_API_KEY=__FILL_ME__
VQA_MODEL_NAME=__FILL_ME__                # e.g. Qwen3.5-35B-A3B
VQA_ENABLE_THINKING=false
VQA_TIMEOUT_SECONDS=300
VQA_RETRIES=1
VQA_VERBALIZE_MAX_TOKENS=1024
VQA_COVERAGE_MAX_TOKENS=2048

# ──── Neo4j ────
VQA_SKIP_NEO4J_DOCKER=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__FILL_ME__

# ──── 运行参数 ────
VQA_Q_BATCH_SIZE=32
VQA_Q_N_WORKERS=32
VQA_CLEAR_RUN_DATA=false
VQA_MAX_EMPTY_STREAK=15
VQA_GAP_FAIL_COOLDOWN=3
