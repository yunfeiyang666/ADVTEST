# 复制为 advtest_runtime.env 并填写密钥（advtest_runtime.env 已加入 .gitignore）
#
# ══ 统一站点（见 official_pipeline/advtest_paths.py，可选 unified_site 兼容层）════
# 服务器推荐只设一项根路径，其余按约定推导：
#   export ADVTEST_ROOT=/home/you/ADVTEST/DATA_new
# 约定：NUSCENES_DATAROOT=$ADVTEST_ROOT/data ，VQA_QA_JSON=$ADVTEST_ROOT/data/NuScenes_val_questions.json
# 再按需覆盖 NEO4J_*、NUSCENES_VERSION、ADVTEST_EXCEL_PATH 等。
#
# ── 多机部署（每台不同）────────────────────────────────────────────────────
# ADVTEST_ROOT=E:/ADVTEST
# ADVTEST_EXCEL_PATH=E:/ADVTEST/data/RQ_server_a.xlsx
# ADVTEST_GEN_QA_DIR=E:/ADVTEST/generated_qa
# FILTERED_SG_DIR=E:/ADVTEST/filtered_scene_graphs
# ADVTEST_FRAME_PLAN_JSON=E:/ADVTEST/nuscenes_s3c_experiment/deploy/frames_server_a.json

# LLM（OpenAI 兼容）
VQA_API_BASE_URL=http://218.197.140.7:3001/v1
VQA_API_KEY=
# 学校网关（名须与 /v1/models 一致）。默认 35B；要 122B 时改三行一致即可。
VQA_MODEL_NAME=Qwen3.5-35B-A3B
VQA_MODEL_AUDIT=Qwen3.5-35B-A3B
VQA_MODEL_RENDER=Qwen3.5-35B-A3B
# 高并行生成（减少往返次数）；按网关限流再调低
VQA_Q_BATCH_SIZE=32
VQA_Q_N_WORKERS=32
VQA_BASELINE_N_WORKERS=32
VQA_LLM_TIMEOUT_READ=180

# nuScenes dataroot（内含 v1.0-trainval/；默认等价于 ADVTEST_ROOT/data）
NUSCENES_DATAROOT=E:/Project/ADVTEST/data
NUSCENES_VERSION=v1.0-trainval
# nuScenes Python SDK 路径（现场构图 V17 必填）：指向含 nuscenes/ 包的 python-sdk 目录
# NUSCENES_DEVKIT_PATH=E:/Project/ADVTEST/nuscenes-devkit/nuscenes-devkit-master/python-sdk

# V17：true = 每帧从 nuScenes 现场生成原始图 + core 过滤后导入 Neo4j，不依赖磁盘 filtered_scene_graphs/*.json
# VQA_BUILD_SCENE_GRAPH_ONTHEFLY=false

# NuScenes-QA val 题集
VQA_QA_JSON=E:/Project/ADVTEST/data/nuscenes/qa/NuScenes_val_questions.json

# Neo4j（官方 Bolt 默认 7687；若映射到 7800 等请改此处）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DOCKER_NAMES=neo4j,advtest-neo4j

# 运行前清空 RQ Excel 全部数据行（保留表头）
VQA_CLEAR_RUN_DATA=false

# ── 校园网 VPN（仅 Windows；run_method_a.py 开头可选自动 rasdial）────────────────
# 先在「设置 → 网络和 Internet → VPN」添加连接，名称必须与 SCHOOL_VPN_CONN_NAME 一致。
# 口令若含 # 等字符，建议整段加双引号：SCHOOL_VPN_PASS="你的密码"
VQA_AUTO_CONNECT_VPN=false
SCHOOL_VPN_CONN_NAME=
SCHOOL_VPN_USER=
SCHOOL_VPN_PASS=
# 可选：学校分配的固定内网 IP；若本机已有该地址则跳过重复拨号
SCHOOL_VPN_EXPECTED_IPV4=
